{
  "name": "canopy-sdk-js",
  "version": "0.3.1-als.2",
  "private": true,
  "description": "TypeScript SDK for building apps on Canopy — live-PV client, typed API contracts, and the shared Carbon app shell",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "build:watch": "pnpm -r --parallel exec tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "pnpm run build && pnpm -r run test",
    "test:watch": "pnpm -r --parallel run test:watch",
    "test:coverage": "pnpm run build && pnpm -r run test:coverage",
    "typecheck": "pnpm run build && pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,css}\" \"packages/*/*.{md,css}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,css}\" \"packages/*/*.{md,css}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.1.1"
}

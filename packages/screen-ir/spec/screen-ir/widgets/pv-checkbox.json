{
  "id": "pv-checkbox",
  "version": "1.0.0",
  "description": "Toggle bound to a boolean or integer PV.",
  "supportsPv": true,
  "supportsRules": true,
  "supportsChildren": false,
  "propSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
      "pv"
    ],
    "properties": {
      "pv": {
        "type": "string",
        "format": "pv-channel"
      },
      "label": {
        "type": "string"
      },
      "kind": {
        "type": "string",
        "enum": [
          "standard",
          "tri-state",
          "toggle"
        ],
        "default": "standard"
      },
      "alarmSensitive": {
        "type": "boolean",
        "default": false
      }
    }
  }
}

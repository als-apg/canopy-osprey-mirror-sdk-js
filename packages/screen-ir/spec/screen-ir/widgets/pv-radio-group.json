{
  "id": "pv-radio-group",
  "version": "1.0.0",
  "description": "Mutually exclusive enum selector for a PV with enum_strings. Authored in the Screen Builder; converter does not auto-translate clusters of QRadioButtons (use a pv-enum-combobox for migrated screens).",
  "supportsPv": true,
  "supportsRules": true,
  "supportsChildren": false,
  "propSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
      "pv"
    ],
    "properties": {
      "pv": {
        "type": "string",
        "format": "pv-channel"
      },
      "orientation": {
        "type": "string",
        "enum": [
          "horizontal",
          "vertical"
        ],
        "default": "vertical"
      },
      "alarmSensitive": {
        "type": "boolean",
        "default": false
      },
      "fontSize": {
        "type": "number",
        "title": "Font Size (px)"
      }
    }
  }
}

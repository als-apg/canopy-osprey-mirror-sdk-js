{
  "id": "absolute-canvas",
  "version": "1.1.0",
  "description": "Root container for absolute-positioned screen widgets. One per screen.",
  "supportsPv": false,
  "supportsRules": false,
  "supportsChildren": true,
  "propSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
      "width",
      "height"
    ],
    "properties": {
      "width": {
        "type": "integer",
        "minimum": 1
      },
      "height": {
        "type": "integer",
        "minimum": 1
      },
      "backgroundColor": {
        "type": "string"
      }
    }
  }
}

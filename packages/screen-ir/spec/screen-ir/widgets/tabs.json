{
  "id": "tabs",
  "version": "1.0.0",
  "description": "Multi-page container. Each tab is one named pane; children are assigned to tabs by index.",
  "supportsPv": false,
  "supportsRules": true,
  "supportsChildren": true,
  "propSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
      "tabs"
    ],
    "properties": {
      "tabs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string"
            }
          }
        }
      },
      "activeIndex": {
        "type": "integer",
        "minimum": 0,
        "default": 0
      }
    }
  }
}

{
  "id": "line",
  "version": "1.0.0",
  "description": "Polyline with optional arrowheads. Vertices are relative to the widget's top-left corner.",
  "supportsPv": false,
  "supportsRules": true,
  "supportsChildren": false,
  "propSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "lineColor": {
        "type": "string",
        "default": "#6f6f6f"
      },
      "lineWidth": {
        "type": "number",
        "minimum": 0,
        "default": 2
      },
      "lineStyle": {
        "type": "string",
        "enum": [
          "solid",
          "dashed",
          "dotted"
        ],
        "default": "solid"
      },
      "points": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "description": "Vertices relative to the widget's top-left corner."
      },
      "arrowStart": {
        "type": "boolean",
        "default": false
      },
      "arrowEnd": {
        "type": "boolean",
        "default": false
      },
      "arrowSize": {
        "type": "number",
        "minimum": 1,
        "default": 10
      },
      "opacity": {
        "type": "number",
        "minimum": 0,
        "maximum": 100,
        "default": 0,
        "description": "Transparency percent; 100 = fully transparent (carries EDM's 'invisible' flag)."
      }
    }
  }
}

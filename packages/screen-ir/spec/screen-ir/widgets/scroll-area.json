{
  "id": "scroll-area",
  "version": "1.0.0",
  "description": "Container with scrollbars when contents overflow.",
  "supportsPv": false,
  "supportsRules": true,
  "supportsChildren": true,
  "propSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "horizontalPolicy": {
        "type": "string",
        "enum": [
          "auto",
          "always-on",
          "always-off"
        ],
        "default": "auto"
      },
      "verticalPolicy": {
        "type": "string",
        "enum": [
          "auto",
          "always-on",
          "always-off"
        ],
        "default": "auto"
      }
    }
  }
}

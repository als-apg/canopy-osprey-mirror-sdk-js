{
  "id": "pv-slider",
  "version": "1.0.0",
  "description": "Slider control bound to a PV setpoint.",
  "supportsPv": true,
  "supportsRules": true,
  "supportsChildren": false,
  "propSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
      "pv"
    ],
    "properties": {
      "pv": {
        "type": "string",
        "format": "pv-channel"
      },
      "min": {
        "type": "number"
      },
      "max": {
        "type": "number"
      },
      "showValue": {
        "type": "boolean",
        "default": true
      },
      "orientation": {
        "type": "string",
        "enum": [
          "horizontal",
          "vertical"
        ],
        "default": "horizontal"
      }
    }
  }
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "resolveJsonModule": true,
    "noEmit": true,
    // For the tests (node:fs etc.). tsconfig.build.json clears it for the library.
    "types": ["node"]
  },
  // The spec's JSON comes in through imports; listing it here would also emit
  // files nothing imports (widget-definition.schema.json) into dist.
  "include": ["src"]
}

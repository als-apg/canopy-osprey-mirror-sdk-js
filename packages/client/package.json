{
  "name": "@canopy/client",
  "version": "0.1.0",
  "private": false,
  "description": "Framework-free TypeScript client for Canopy's live-PV protocol (Hare WebSocket) and typed wire DTOs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^4.1.6"
  }
}
